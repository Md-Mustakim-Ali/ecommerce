# Dependencies
node_modules/
.pnpm-store/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

# Next.js
.next/
out/
next-env.d.ts

# Build output
build/
dist/
.turbo/
.vercel/

# TypeScript
*.tsbuildinfo

# Testing
coverage/
*.lcov
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime
pids/
*.pid
*.pid.lock
*.seed

# Environment
#
# Every .env variant is ignored, including .env.development and .env.production,
# which Next loads and which people forget are real files. .env.example is the
# committed template and is the only one that may ever contain a real value —
# and it must not.
#
# This is a payments application. A DATABASE_URL or a provider secret in git
# history is not fixed by a later commit; it is fixed by rotating the secret.
.env
.env.*
!.env.example

# Local TLS certificates and keys
*.pem
*.key
*.crt
*.p12

# Editors
.idea/
.vscode/
*.swp

# OS
#
# This repo lives inside a OneDrive folder, which writes desktop.ini into
# directories it syncs and leaves ~$ lock files behind Office documents.
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
~$*
*~

# Claude Code
# .claude/launch.json is shared. settings.local.json is per-machine.
.claude/settings.local.json

# NOT ignored, deliberately:
#
#   lib/db/migrations/   Generated SQL plus the drizzle-kit journal are the
#                        source of truth for schema history. Committing them is
#                        what makes a migration reproducible on another machine
#                        and in CI. Never add these here.
#   .env.example         The template. Keep it in sync when a variable is added.
